    {
      "parameters": {
        "jsCode": "const searchedEmail = $node[\"Code in JavaScript2\"].json.email;\n\nconst appointments = $input.all();\n\nconst found = appointments.find(item => {\n  const data = item.json;\n\n  const emailField =\n    data.email ||\n    data.Email ||\n    data.patientEmail ||\n    data.patient_email ||\n    \"\";\n\n  return emailField.toLowerCase().trim() === searchedEmail.toLowerCase().trim();\n});\n\nif (!found) {\n  return [\n    {\n      json: {\n        found: false,\n        email: searchedEmail,\n        message: \"No appointment found\"\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      found: true,\n      ...found.json\n    }\n  }\n];"
      },
