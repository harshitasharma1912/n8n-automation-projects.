            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a viral LinkedIn content creator. Generate engaging LinkedIn posts with hooks, insights, emojis, hashtags and a call to action.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Topic: {{$json.Topic}}\\nAudience: {{$json.audience}}\\nPlatform: {{$json.platform}}\\n\\nGenerate:\\n1. LinkedIn caption\\n2. 10 hashtags\\n3. AI image prompt\\n\\nReturn the response in JSON format.\"\n    }\n  ],\n  \"temperature\": 0.8\n}",
        "options": {}
      },
