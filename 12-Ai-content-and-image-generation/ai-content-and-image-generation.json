      "id": "fdfe8a7f-3b18-4f46-9283-bbdee8238277",
      "name": "Send a photo message"
    },
    {
      "parameters": {
        "jsCode": "const content = $json.choices[0].message.content;\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(content);\n} catch (e) {\n  parsed = {\n    caption: content,\n    image_prompt: \"Professional AI productivity workspace, modern technology\"\n  };\n}\n\nreturn [{\n  json: {\n    caption: parsed.caption,\n    image_prompt: parsed.image_prompt\n  }\n}];"
      },
