        "jsCode": "const content = $json.text;\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody{\n    font-family: Arial, sans-serif;\n    margin:40px;\n    line-height:1.6;\n}\nh1,h2,h3{\n    color:#1e3a8a;\n}\npre{\n    background:#f4f4f4;\n    padding:10px;\n}\ntable{\n    border-collapse:collapse;\n    width:100%;\n}\ntd,th{\n    border:1px solid #ccc;\n    padding:8px;\n}\n</style>\n</head>\n\n<body>\n\n${content.replace(/\\n/g,\"<br>\")}\n\n</body>\n</html>\n`;\n\nreturn [\n{\njson:{\nhtml\n}\n}\n];"
